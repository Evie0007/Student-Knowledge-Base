<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="studentkb.controller.DefineStudentProfileController" prefHeight="800" prefWidth="800">
    <top>
        <VBox styleClass="header">
            <Label text="Define Student Profile" styleClass="page-title"/>
        </VBox>
    </top>

    <center>
        <ScrollPane styleClass="page-scroll" fitToWidth="true">
            <GridPane styleClass="card" hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70"/>
                </columnConstraints>

                <Label text="Student Full Name:" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Please enter full name"/>

                <Label text="Preferred Role:" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ChoiceBox fx:id="roleChoice" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Academic Status:" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ChoiceBox fx:id="academicChoice" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Job Status:" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <HBox spacing="16" GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <RadioButton fx:id="employedRadio" text="Employed"/>
                    <RadioButton fx:id="notEmployedRadio" text="Not Employed"/>
                </HBox>

                <Label text="Job Details:" styleClass="field-label,top-label" GridPane.valignment="TOP" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextArea fx:id="jobDetailsArea" GridPane.rowIndex="4" GridPane.columnIndex="1" prefRowCount="2"/>

                <Label text="Programming Languages (multi-select):" styleClass="field-label,top-label" GridPane.valignment="TOP" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ListView fx:id="languagesList" GridPane.rowIndex="5" GridPane.columnIndex="1" prefHeight="140"/>

                <Label text="Databases Known (multi-select):" styleClass="field-label,top-label" GridPane.valignment="TOP" wrapText="true" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ListView fx:id="databasesList" GridPane.rowIndex="6" GridPane.columnIndex="1" prefHeight="90"/>

                <Label text="Faculty Comments:" styleClass="field-label,top-label" GridPane.valignment="TOP" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <VBox spacing="8" GridPane.rowIndex="7" GridPane.columnIndex="1">
                    <TextArea fx:id="commentArea" prefRowCount="2" promptText="Enter a comment, then click Add +"/>
                    <HBox spacing="8">
                        <Button text="Add +" onAction="#onAddComment" styleClass="accent"/>
                    </HBox>
                    <ListView fx:id="commentsList" prefHeight="70"/>
                </VBox>

                <Label text="Flags:" styleClass="field-label" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <HBox spacing="20" GridPane.rowIndex="8" GridPane.columnIndex="1">
                    <CheckBox fx:id="whitelistCheck" text="Whitelisted"/>
                    <CheckBox fx:id="blacklistCheck" text="Blacklisted"/>
                </HBox>
            </GridPane>
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="10">
            <Button text="Cancel" onAction="#onCancel"/>
            <Button text="Save" onAction="#onSave" styleClass="primary"/>
        </HBox>
    </bottom>
</BorderPane>
