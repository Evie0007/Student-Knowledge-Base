<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="studentkb.controller.DefineLanguagesController" prefHeight="800" prefWidth="800">
    <top>
        <VBox styleClass="header">
            <Label text="Define Programming Languages" styleClass="page-title"/>
        </VBox>
    </top>
    <center>
        <VBox styleClass="card" spacing="12">
            <Label text="Languages students can choose from" styleClass="section-title"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="nameField" promptText="Language name" HBox.hgrow="ALWAYS"/>
                <Button fx:id="addButton" text="Add" onAction="#onAddLanguage" styleClass="primary"/>
                <Button fx:id="deleteButton" text="Delete Selected" onAction="#onDeleteLanguage" disable="true" styleClass="danger"/>
            </HBox>
            <ListView fx:id="languagesList" VBox.vgrow="ALWAYS"/>
            <BorderPane.margin><Insets top="20" right="20" bottom="20" left="20"/></BorderPane.margin>
        </VBox>
    </center>
    <bottom>
        <HBox styleClass="footer" alignment="CENTER_RIGHT" spacing="10">
            <Button text="Back" onAction="#onBack"/>
        </HBox>
    </bottom>
</BorderPane>
